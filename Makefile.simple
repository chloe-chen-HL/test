# 简化的Makefile for gtest unit tests (不依赖Qt)
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -g -O0
GTEST_LIB = -lgtest -lgtest_main -lgmock -lpthread

# 目标文件
TARGET = test_command_event_handler_simple
TEST_SOURCE = test_command_event_handler_simple.cpp

# 默认目标
all: $(TARGET)

# 编译测试程序
$(TARGET): $(TEST_SOURCE)
	$(CXX) $(CXXFLAGS) -o $@ $< $(GTEST_LIB)

# 运行测试
test: $(TARGET)
	./$(TARGET)

# 运行测试并显示详细信息
test-verbose: $(TARGET)
	./$(TARGET) --gtest_verbose

# 运行特定测试
test-specific: $(TARGET)
	./$(TARGET) --gtest_filter=CommandEventHandlerTest.HandleActionMoveToReadyCommand

# 运行测试并生成XML报告
test-xml: $(TARGET)
	./$(TARGET) --gtest_output=xml:test_results.xml

# 运行测试并显示颜色输出
test-color: $(TARGET)
	./$(TARGET) --gtest_color=yes

# 清理
clean:
	rm -f $(TARGET) test_results.xml

# 安装依赖（Ubuntu/Debian）
install-deps:
	sudo apt-get update
	sudo apt-get install -y libgtest-dev libgmock-dev build-essential

# 安装依赖（CentOS/RHEL/Fedora）
install-deps-rpm:
	sudo yum install -y gtest-devel gmock-devel gcc-c++

# 安装依赖（Arch Linux）
install-deps-arch:
	sudo pacman -S gtest gmock base-devel

# 检查依赖是否已安装
check-deps:
	@echo "检查gtest依赖..."
	@pkg-config --exists gtest && echo "✓ gtest已安装" || echo "✗ gtest未安装"
	@echo "检查gmock依赖..."
	@pkg-config --exists gmock && echo "✓ gmock已安装" || echo "✗ gmock未安装"

# 帮助信息
help:
	@echo "可用的目标:"
	@echo "  all          - 编译测试程序"
	@echo "  test         - 运行所有测试"
	@echo "  test-verbose - 运行测试并显示详细信息"
	@echo "  test-specific- 运行特定测试"
	@echo "  test-xml     - 运行测试并生成XML报告"
	@echo "  test-color   - 运行测试并显示颜色输出"
	@echo "  clean        - 清理编译文件"
	@echo "  install-deps - 安装依赖（Ubuntu/Debian）"
	@echo "  install-deps-rpm - 安装依赖（CentOS/RHEL/Fedora）"
	@echo "  install-deps-arch - 安装依赖（Arch Linux）"
	@echo "  check-deps   - 检查依赖是否已安装"
	@echo "  help         - 显示此帮助信息"

.PHONY: all test test-verbose test-specific test-xml test-color clean install-deps install-deps-rpm install-deps-arch check-deps help